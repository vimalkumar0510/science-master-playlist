G and Notes/Phy _ 28 March _ Class PNG.pdf", "subject": "Physics", "size": 2729763}, {"id": "Physics PNG and Notes/Phy _ 28 May _ Class PNG.pdf", "name": "Phy _ 28 May _ Class PNG.pdf", "path": "Physics PNG and Notes/Phy _ 28 May _ Class PNG.pdf", "subject": "Physics", "size": 1270791}, {"id": "Physics PNG and Notes/Phy _ 29 April _ Class PNG.pdf", "name": "Phy _ 29 April _ Class PNG.pdf", "path": "Physics PNG and Notes/Phy _ 29 April _ Class PNG.pdf", "subject": "Physics", "size": 790191}, {"id": "Physics PNG and Notes/Phy _ 29 March _ Class PNG.pdf", "name": "Phy _ 29 March _ Class PNG.pdf", "path": "Physics PNG and Notes/Phy _ 29 March _ Class PNG.pdf", "subject": "Physics", "size": 1651354}, {"id": "Physics PNG and Notes/Phy _ 3 April _ Class PNG.pdf", "name": "Phy _ 3 April _ Class PNG.pdf", "path": "Physics PNG and Notes/Phy _ 3 April _ Class PNG.pdf", "subject": "Physics", "size": 905242}, {"id": "Physics PNG and Notes/Phy _ 3 Jan _ Class PNG.pdf", "name": "Phy _ 3 Jan _ Class PNG.pdf", "path": "Physics PNG and Notes/Phy _ 3 Jan _ Class PNG.pdf", "subject": "Physics", "size": 680981}, {"id": "Physics PNG and Notes/Phy _ 30 April _ Class PNG.pdf", "name": "Phy _ 30 April _ Class PNG.pdf", "path": "Physics PNG and Notes/Phy _ 30 April _ Class PNG.pdf", "subject": "Physics", "size": 5781297}, {"id": "Physics PNG and Notes/Phy _ 4 April _ Class PNG (1).pdf", "name": "Phy _ 4 April _ Class PNG (1).pdf", "path": "Physics PNG and Notes/Phy _ 4 April _ Class PNG (1).pdf", "subject": "Physics", "size": 1386215}, {"id": "Physics PNG and Notes/Phy _ 4 April _ Class PNG.pdf", "name": "Phy _ 4 April _ Class PNG.pdf", "path": "Physics PNG and Notes/Phy _ 4 April _ Class PNG.pdf", "subject": "Physics", "size": 802864}, {"id": "Physics PNG and Notes/Phy _ 5 April _ Class PNG.pdf", "name": "Phy _ 5 April _ Class PNG.pdf", "path": "Physics PNG and Notes/Phy _ 5 April _ Class PNG.pdf", "subject": "Physics", "size": 802864}, {"id": "Physics PNG and Notes/Phy _ 5 May _ Class PNG.pdf", "name": "Phy _ 5 May _ Class PNG.pdf", "path": "Physics PNG and Notes/Phy _ 5 May _ Class PNG.pdf", "subject": "Physics", "size": 746116}, {"id": "Physics PNG and Notes/Phy _ 6 Feb _ Class PNG.pdf", "name": "Phy _ 6 Feb _ Class PNG.pdf", "path": "Physics PNG and Notes/Phy _ 6 Feb _ Class PNG.pdf", "subject": "Physics", "size": 1880524}, {"id": "Physics PNG and Notes/Phy _ 6 May _ Class PNG.pdf", "name": "Phy _ 6 May _ Class PNG.pdf", "path": "Physics PNG and Notes/Phy _ 6 May _ Class PNG.pdf", "subject": "Physics", "size": 819056}, {"id": "Physics PNG and Notes/Phy _ 7 March _ Class PNG.pdf", "name": "Phy _ 7 March _ Class PNG.pdf", "path": "Physics PNG and Notes/Phy _ 7 March _ Class PNG.pdf", "subject": "Physics", "size": 7259342}, {"id": "Physics PNG and Notes/Phy _ 8 March _ Class PNG.pdf", "name": "Phy _ 8 March _ Class PNG.pdf", "path": "Physics PNG and Notes/Phy _ 8 March _ Class PNG.pdf", "subject": "Physics", "size": 6225568}, {"id": "Physics PNG and Notes/Phy _ 8 May _ Class PNG.pdf", "name": "Phy _ 8 May _ Class PNG.pdf", "path": "Physics PNG and Notes/Phy _ 8 May _ Class PNG.pdf", "subject": "Physics", "size": 3814783}, {"id": "Physics PNG and Notes/Physics Complete Class PNG.pdf", "name": "Physics Complete Class PNG.pdf", "path": "Physics PNG and Notes/Physics Complete Class PNG.pdf", "subject": "Physics", "size": 5783013}];
  let doneSet = new Set(JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]"));

  const listEl = document.getElementById("pdfLinksList");
  const totalEl = document.getElementById("pdfTotalCount");
  const doneEl = document.getElementById("pdfDoneCount");
  const searchEl = document.getElementById("pdfSearchBox");

  function fmtSize(b) {
    if (b < 1024) return b + " B";
    if (b < 1048576) return (b / 1024).toFixed(1) + " KB";
    return (b / 1048576).toFixed(2) + " MB";
  }

  function encPath(p) {
    return p.split("/").map(encodeURIComponent).join("/");
  }

  function updateStats() {
    totalEl.textContent = pdfFiles.length;
    doneEl.textContent = `${doneSet.size} / ${pdfFiles.length}`;
  }

  listEl.addEventListener("click", function(e) {
    const btn = e.target.closest(".pdf-chk-btn");
    if (!btn) return;
    const id = btn.getAttribute("data-id");
    if (doneSet.has(id)) doneSet.delete(id);
    else doneSet.add(id);
    localStorage.setItem(STORAGE_KEY, JSON.stringify([...doneSet]));
    updateStats();
    drawPDFs();
  });

  function drawPDFs() {
    const term = (searchEl.value || "").trim().toLowerCase();
    const rows = pdfFiles.filter(f =>
      f.name.toLowerCase().includes(term) || f.subject.toLowerCase().includes(term)
    );

    if (!rows.length) {
      listEl.innerHTML = '<li style="padding:12px;background:#fff;border-radius:8px;color:#64748b;">Koi matching PDF nahi mili.</li>';
      return;
    }

    listEl.innerHTML = rows.map(f => {
      const isDone = doneSet.has(f.id);
      return `
        <li style="display:flex;justify-content:space-between;align-items:center;gap:12px;padding:10px 14px;background:${isDone ? "#ecfdf5" : "#ffffff"};border:1px solid ${isDone ? "#6ee7b7" : "#e2e8f0"};border-radius:8px;">
          <a href="${encPath(f.path)}" target="_blank" rel="noopener" style="text-decoration:none;color:#0f172a;font-weight:500;word-break:break-word;flex:1;${isDone ? "text-decoration:line-through;color:#065f46;" : ""}">
            <span style="display:inline-block;font-size:.72rem;font-weight:700;padding:2px 8px;border-radius:999px;background:#e0f2fe;color:#0369a1;margin-right:8px;">${f.subject}</span>
            ${f.name}
          </a>
          <div style="display:flex;align-items:center;gap:8px;flex-shrink:0;">
            <span style="font-size:.78rem;font-weight:600;padding:3px 9px;border-radius:999px;background:#f1f5f9;color:#334155;">${fmtSize(f.size)}</span>
            <button type="button" class="pdf-chk-btn" data-id="${f.id.replace(/"/g, "&quot;")}" style="padding:5px 10px;border-radius:6px;border:1px solid #94a3b8;background:${isDone ? "#10b981" : "#fff"};color:${isDone ? "#fff" : "#0f172a"};font-size:.78rem;font-weight:600;cursor:pointer;">
              ${isDone ? "✓ Done" : "Mark Done"}
            </button>
          </div>
        </li>
      `;
    }).join("");
  }

  searchEl.addEventListener("input", drawPDFs);
  updateStats();
  drawPDFs();
})();
</script>
<!-- ADDED_PDF_SECTION_END -->
</body></html>