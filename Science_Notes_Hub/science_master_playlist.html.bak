<!DOCTYPE html>
<html lang="en"><head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Science Master Playlist — Chemistry, Biology &amp; Physics</title>
    <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
    <style>
        :root {
            --bg-dark: #070b19;
            --card-bg: rgba(17, 25, 48, 0.55);
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --cyan: #06b6d4;
            --violet: #8b5cf6;
            --pink: #ec4899;
            --emerald: #10b981;
            --amber: #f59e0b;
            --danger: #ef4444;
            --glass-border: rgba(255, 255, 255, 0.09);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        ::-webkit-scrollbar {
            width: 10px;
            height: 10px;
        }
        ::-webkit-scrollbar-track {
            background: #060914;
        }
        ::-webkit-scrollbar-thumb {
            background: linear-gradient(180deg, var(--cyan), var(--violet), var(--pink));
            border-radius: 999px;
            border: 2px solid #060914;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: linear-gradient(180deg, #22d3ee, #a855f7, #f472b6);
        }

        body {
            font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-main);
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
            padding: 28px 16px 60px;
            line-height: 1.5;
        }

        .bg-orbs {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: -1;
            overflow: hidden;
            background: radial-gradient(circle at 50% 0%, rgba(15, 23, 42, 0.9) 0%, #050814 100%);
        }
        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(95px);
            opacity: 0.45;
            animation: floatOrb 18s ease-in-out infinite alternate;
        }
        .orb-cyan {
            width: 440px; height: 440px; background: radial-gradient(circle, var(--cyan), transparent 70%); top: -100px; left: -120px; animation-duration: 16s;
        }
        .orb-violet {
            width: 500px; height: 500px; background: radial-gradient(circle, var(--violet), transparent 70%); bottom: -140px; right: -120px; animation-duration: 22s; animation-delay: -5s;
        }
        .orb-pink {
            width: 360px; height: 360px; background: radial-gradient(circle, var(--pink), transparent 70%); top: 40%; left: 55%; opacity: 0.28; animation-duration: 25s; animation-delay: -10s;
        }

        @keyframes floatOrb {
            0%   { transform: translate(0, 0) scale(1); }
            50%  { transform: translate(60px, 45px) scale(1.12); }
            100% { transform: translate(-45px, 70px) scale(0.94); }
        }

        .container {
            max-width: 1180px;
            margin: 0 auto;
            position: relative;
            z-index: 1;
        }

        .subject-tabs {
            display: flex;
            gap: 14px;
            margin-bottom: 22px;
            flex-wrap: wrap;
        }
        .subject-tab {
            flex: 1;
            min-width: 220px;
            padding: 16px 20px;
            border-radius: 18px;
            border: 1px solid var(--glass-border);
            background: rgba(17, 25, 48, 0.55);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            color: var(--text-main);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            transition: all 0.28s cubic-bezier(0.22, 1, 0.36, 1);
            position: relative;
            overflow: hidden;
        }
        .subject-tab:hover {
            transform: translateY(-3px);
            border-color: rgba(6, 182, 212, 0.4);
            box-shadow: 0 10px 28px rgba(6, 182, 212, 0.14);
        }
        .subject-tab.active {
            background: linear-gradient(135deg, rgba(6, 182, 212, 0.22), rgba(139, 92, 246, 0.22));
            border-color: var(--cyan);
            box-shadow: 0 0 28px rgba(6, 182, 212, 0.25), inset 0 0 18px rgba(139, 92, 246, 0.15);
        }
        .subject-tab.active.bio-tab {
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.22), rgba(6, 182, 212, 0.22));
            border-color: var(--emerald);
            box-shadow: 0 0 28px rgba(16, 185, 129, 0.25), inset 0 0 18px rgba(6, 182, 212, 0.15);
        }
        .subject-tab.active.phy-tab {
            background: linear-gradient(135deg, rgba(245, 158, 11, 0.22), rgba(236, 72, 153, 0.22));
            border-color: var(--amber);
            box-shadow: 0 0 28px rgba(245, 158, 11, 0.25), inset 0 0 18px rgba(236, 72, 153, 0.15);
        }

        .tab-left {
            display: flex;
            align-items: center;
            gap: 12px;
            text-align: left;
        }
        .tab-icon {
            font-size: 1.6rem;
            width: 44px;
            height: 44px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid var(--glass-border);
        }
        .tab-title {
            font-size: 1.05rem;
            font-weight: 800;
            letter-spacing: -0.2px;
        }
        .tab-sub {
            font-size: 0.78rem;
            color: var(--text-muted);
            margin-top: 2px;
        }
        .tab-pill {
            font-size: 0.76rem;
            font-weight: 700;
            padding: 5px 10px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.07);
            border: 1px solid var(--glass-border);
            color: #38bdf8;
            white-space: nowrap;
        }
        .bio-tab .tab-pill { color: #34d399; }
        .phy-tab .tab-pill { color: #fbbf24; }

        header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 24px;
            padding: 28px 30px;
            margin-bottom: 26px;
            background: rgba(17, 25, 48, 0.6);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border: 1px solid var(--glass-border);
            border-radius: 22px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
            position: relative;
            overflow: hidden;
        }
        header::before {
            content: "";
            position: absolute;
            top: 0; left: 0; right: 0; height: 2px;
            background: linear-gradient(90deg, transparent, var(--cyan), var(--violet), var(--pink), transparent);
        }

        .header-left {
            flex: 1;
            min-width: 260px;
        }
        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 1.4px;
            font-weight: 700;
            color: #38bdf8;
            background: rgba(6, 182, 212, 0.12);
            border: 1px solid rgba(6, 182, 212, 0.3);
            padding: 4px 12px;
            border-radius: 999px;
            margin-bottom: 10px;
        }

        .shimmer-title {
            font-size: clamp(1.6rem, 3.5vw, 2.35rem);
            font-weight: 800;
            letter-spacing: -0.5px;
            background: linear-gradient(90deg, #22d3ee 0%, #a855f7 35%, #ec4899 65%, #22d3ee 100%);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: shimmerText 4.5s linear infinite;
            margin-bottom: 6px;
        }
        @keyframes shimmerText {
            0%   { background-position: 0% center; }
            100% { background-position: 200% center; }
        }

        .subtitle {
            color: var(--text-muted);
            font-size: 0.95rem;
        }

        .progress-panel {
            display: flex;
            align-items: center;
            gap: 18px;
            background: rgba(9, 13, 28, 0.65);
            padding: 14px 20px;
            border-radius: 18px;
            border: 1px solid var(--glass-border);
        }
        .progress-ring {
            width: 72px; height: 72px; border-radius: 50%;
            background: conic-gradient(var(--cyan) 0deg, var(--violet) 0deg, rgba(255,255,255,0.08) 0deg);
            display: flex; align-items: center; justify-content: center;
            position: relative; box-shadow: 0 0 22px rgba(6, 182, 212, 0.25);
            transition: background 0.3s ease; flex-shrink: 0;
        }
        .progress-ring::after {
            content: ""; position: absolute; inset: 6px; background: #0b1124; border-radius: 50%;
        }
        .progress-ring span {
            position: relative; z-index: 2; font-size: 0.95rem; font-weight: 800;
            background: linear-gradient(135deg, #22d3ee, #c084fc);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }
        .progress-meta {
            display: flex; flex-direction: column; gap: 6px;
        }
        .progress-count { font-size: 0.92rem; font-weight: 700; color: var(--text-main); }
        .progress-sub { font-size: 0.78rem; color: var(--text-muted); }

        .reset-btn {
            background: rgba(239, 68, 68, 0.14); color: #fca5a5;
            border: 1px solid rgba(239, 68, 68, 0.35);
            padding: 6px 12px; border-radius: 8px; font-size: 0.78rem; font-weight: 600;
            cursor: pointer; transition: all 0.2s ease; display: inline-flex; align-items: center; gap: 5px; width: fit-content;
        }
        .reset-btn:hover {
            background: var(--danger); color: #fff; box-shadow: 0 0 15px rgba(239, 68, 68, 0.45); transform: translateY(-1px);
        }

        .toolbar {
            display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 24px; align-items: center;
        }
        .search-wrap { flex: 1; min-width: 250px; position: relative; }
        .search-input {
            width: 100%; padding: 13px 16px 13px 42px; border-radius: 14px;
            border: 1px solid var(--glass-border); background: rgba(17, 25, 48, 0.65);
            backdrop-filter: blur(12px); color: var(--text-main); font-size: 0.95rem; outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .search-input:focus { border-color: var(--cyan); box-shadow: 0 0 18px rgba(6, 182, 212, 0.25); }
        .search-icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); pointer-events: none; }

        .filter-group { display: flex; gap: 8px; flex-wrap: wrap; }
        .tool-btn {
            padding: 11px 16px; border-radius: 12px; border: 1px solid var(--glass-border);
            background: rgba(17, 25, 48, 0.65); backdrop-filter: blur(12px); color: var(--text-main);
            font-size: 0.85rem; font-weight: 600; cursor: pointer; transition: all 0.2s ease;
            display: inline-flex; align-items: center; gap: 6px;
        }
        .tool-btn:hover, .tool-btn.active {
            background: linear-gradient(135deg, rgba(6, 182, 212, 0.22), rgba(139, 92, 246, 0.22));
            border-color: var(--cyan); box-shadow: 0 0 16px rgba(6, 182, 212, 0.25);
        }

        .class-grid {
            display: grid; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr)); gap: 18px;
        }

        .class-card {
            position: relative; background: var(--card-bg); backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px); border-radius: 18px; padding: 20px;
            border: 1px solid var(--glass-border); display: flex; flex-direction: column;
            justify-content: space-between; gap: 16px; overflow: hidden;
            transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.28s ease;
            opacity: 0; animation: fadeUpCard 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }

        @keyframes fadeUpCard {
            from { opacity: 0; transform: translateY(24px) scale(0.98); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        .class-card::before {
            content: ""; position: absolute; inset: 0; border-radius: 18px; padding: 1.6px;
            background: linear-gradient(135deg, var(--cyan), var(--violet), var(--pink), var(--cyan));
            background-size: 300% 300%;
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor; mask-composite: exclude; opacity: 0;
            transition: opacity 0.3s ease; pointer-events: none;
        }

        .class-card::after {
            content: ""; position: absolute; top: 0; left: -130%; width: 65%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.11), transparent);
            transform: skewX(-24deg); transition: left 0.65s ease; pointer-events: none;
        }

        .class-card:hover {
            transform: translateY(-5px); box-shadow: 0 14px 34px rgba(6, 182, 212, 0.16), 0 0 25px rgba(139, 92, 246, 0.14);
        }
        .class-card:hover::before { opacity: 1; animation: borderFlow 3s linear infinite; }
        .class-card:hover::after { left: 145%; }

        @keyframes borderFlow {
            0%   { background-position: 0% 50%; }
            50%  { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .class-card.watched {
            background: rgba(16, 185, 129, 0.08); border-color: rgba(16, 185, 129, 0.35);
        }

        .card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
        .badge {
            background: linear-gradient(135deg, rgba(6, 182, 212, 0.2), rgba(139, 92, 246, 0.2));
            border: 1px solid rgba(6, 182, 212, 0.35); color: #38bdf8; font-weight: 800;
            font-size: 0.78rem; padding: 5px 11px; border-radius: 999px; letter-spacing: 0.5px;
        }
        .badge.bio-badge {
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.2), rgba(6, 182, 212, 0.2));
            border-color: rgba(16, 185, 129, 0.4); color: #34d399;
        }
        .badge.phy-badge {
            background: linear-gradient(135deg, rgba(245, 158, 11, 0.2), rgba(236, 72, 153, 0.2));
            border-color: rgba(245, 158, 11, 0.4); color: #fbbf24;
        }

        .watched-pill {
            display: inline-flex; align-items: center; gap: 6px; font-size: 0.78rem; font-weight: 700;
            padding: 5px 11px; border-radius: 999px; cursor: pointer; user-select: none;
            border: 1px solid var(--glass-border); background: rgba(255, 255, 255, 0.04);
            color: var(--text-muted); transition: all 0.2s ease;
        }
        .watched-pill:hover { border-color: var(--emerald); color: #fff; }
        .watched-pill.is-watched {
            background: rgba(16, 185, 129, 0.18); border-color: rgba(16, 185, 129, 0.5); color: #34d399;
        }

        .card-title {
            font-size: 1.04rem; font-weight: 700; color: var(--text-main); line-height: 1.4; cursor: pointer; transition: color 0.2s;
        }
        .card-title:hover { color: #38bdf8; }

        .topic-tag { display: none; }

        .card-actions {
            display: flex; align-items: center; gap: 8px; padding-top: 10px; border-top: 1px solid rgba(255, 255, 255, 0.06);
        }
        .btn {
            padding: 9px 13px; border-radius: 10px; border: 1px solid var(--glass-border);
            background: rgba(255, 255, 255, 0.05); color: var(--text-main); font-size: 0.82rem; font-weight: 600;
            cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; justify-content: center;
            gap: 6px; transition: all 0.2s ease;
        }
        .btn:hover {
            background: rgba(255, 255, 255, 0.12); border-color: rgba(255, 255, 255, 0.25); transform: translateY(-1px);
        }
        .btn-play {
            flex: 1; background: linear-gradient(135deg, var(--cyan), var(--violet)); border: none; color: #fff; font-weight: 700; box-shadow: 0 4px 15px rgba(6, 182, 212, 0.3);
        }
        .btn-play:hover { background: linear-gradient(135deg, #22d3ee, #a855f7); box-shadow: 0 6px 22px rgba(139, 92, 246, 0.45); }
        .btn-play.bio-play { background: linear-gradient(135deg, var(--emerald), var(--cyan)); box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3); }
        .btn-play.bio-play:hover { background: linear-gradient(135deg, #34d399, #22d3ee); box-shadow: 0 6px 22px rgba(6, 182, 212, 0.45); }
        .btn-play.phy-play { background: linear-gradient(135deg, var(--amber), var(--pink)); box-shadow: 0 4px 15px rgba(245, 158, 11, 0.3); }
        .btn-play.phy-play:hover { background: linear-gradient(135deg, #fbbf24, #f472b6); box-shadow: 0 6px 22px rgba(236, 72, 153, 0.45); }

        .modal-backdrop {
            position: fixed; inset: 0; background: rgba(4, 7, 17, 0.84); backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px); z-index: 1000; display: flex; align-items: center; justify-content: center;
            padding: 18px; opacity: 0; visibility: hidden; transition: opacity 0.28s ease, visibility 0.28s ease;
        }
        .modal-backdrop.open { opacity: 1; visibility: visible; }

        .modal-content {
            width: 100%; max-width: 960px; background: #0b1124; border-radius: 20px; padding: 2px;
            background-image: linear-gradient(135deg, var(--cyan), var(--violet), var(--pink));
            box-shadow: 0 0 45px rgba(6, 182, 212, 0.35), 0 0 80px rgba(139, 92, 246, 0.25);
            transform: scale(0.88) translateY(24px); transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1); overflow: hidden;
        }
        .modal-backdrop.open .modal-content { transform: scale(1) translateY(0); }

        .modal-inner { background: #080d1d; border-radius: 18px; overflow: hidden; }

        .modal-header {
            display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 20px;
            background: rgba(17, 25, 48, 0.85); border-bottom: 1px solid var(--glass-border); flex-wrap: wrap;
        }
        .modal-title {
            font-size: 1.02rem; font-weight: 700; background: linear-gradient(90deg, #22d3ee, #c084fc);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }
        .modal-controls { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
        .esc-hint {
            font-size: 0.72rem; color: var(--text-muted); border: 1px solid var(--glass-border);
            padding: 3px 8px; border-radius: 6px; background: rgba(255, 255, 255, 0.04);
        }
        .speed-select {
            background: #0f172a; color: var(--text-main); border: 1px solid var(--glass-border);
            padding: 5px 10px; border-radius: 8px; font-size: 0.82rem; cursor: pointer;
        }
        .close-modal-btn {
            background: rgba(239, 68, 68, 0.2); color: #fca5a5; border: 1px solid rgba(239, 68, 68, 0.4);
            padding: 6px 13px; border-radius: 8px; font-size: 0.82rem; font-weight: 700; cursor: pointer; transition: all 0.2s;
        }
        .close-modal-btn:hover { background: var(--danger); color: #fff; }

        .video-wrapper {
            position: relative; width: 100%; background: #000; aspect-ratio: 16 / 9; display: flex; align-items: center; justify-content: center;
        }
        video { width: 100%; height: 100%; display: block; }
        .spinner-overlay {
            position: absolute; inset: 0; background: rgba(5, 8, 20, 0.65); display: flex; flex-direction: column;
            align-items: center; justify-content: center; gap: 12px; z-index: 5; pointer-events: none; opacity: 0; transition: opacity 0.25s ease;
        }
        .spinner-overlay.active { opacity: 1; }
        .spinner {
            width: 52px; height: 52px; border-radius: 50%; border: 4px solid rgba(255, 255, 255, 0.1);
            border-top-color: var(--cyan); border-right-color: var(--violet); animation: spinLoader 0.85s linear infinite;
        }
        @keyframes spinLoader { to { transform: rotate(360deg); } }
        .spinner-text { font-size: 0.84rem; color: #cbd5e1; font-weight: 600; letter-spacing: 0.4px; }

        .modal-footer {
            display: flex; align-items: center; justify-content: space-between; padding: 12px 20px;
            background: rgba(17, 25, 48, 0.75); border-top: 1px solid var(--glass-border); flex-wrap: wrap; gap: 10px;
        }

        .empty-state {
            grid-column: 1 / -1; text-align: center; padding: 48px 20px; background: var(--card-bg);
            border: 1px solid var(--glass-border); border-radius: 18px; color: var(--text-muted);
        }

        @media (max-width: 680px) {
            body { padding: 16px 12px 48px; }
            header { padding: 20px 18px; flex-direction: column; align-items: stretch; }
            .progress-panel { justify-content: space-between; }
            .class-grid { grid-template-columns: 1fr; gap: 14px; }
            .esc-hint { display: none; }
        }
    </style>
</head>
<body>

<div class="bg-orbs">
    <div class="orb orb-cyan"></div>
    <div class="orb orb-violet"></div>
    <div class="orb orb-pink"></div>
</div>

<div class="container">
    <div class="subject-tabs">
        <button class="subject-tab active" id="tab-chem" onclick="switchSubject('chem')">
            <div class="tab-left">
                <div class="tab-icon">🧪</div>
                <div>
                    <div class="tab-title">Chemistry</div>
                    <div class="tab-sub">34 Classes</div>
                </div>
            </div>
            <span class="tab-pill" id="tabBadgeChem">0 / 34</span>
        </button>

        <button class="subject-tab bio-tab" id="tab-bio" onclick="switchSubject('bio')">
            <div class="tab-left">
                <div class="tab-icon">🧬</div>
                <div>
                    <div class="tab-title">Biology</div>
                    <div class="tab-sub">49 Classes</div>
                </div>
            </div>
            <span class="tab-pill" id="tabBadgeBio">0 / 49</span>
        </button>

        <button class="subject-tab phy-tab" id="tab-phy" onclick="switchSubject('phy')">
            <div class="tab-left">
                <div class="tab-icon">⚡</div>
                <div>
                    <div class="tab-title">Physics</div>
                    <div class="tab-sub">63 Classes</div>
                </div>
            </div>
            <span class="tab-pill" id="tabBadgePhy">0 / 63</span>
        </button>
    </div>

    <header>
        <div class="header-left">
            <span class="eyebrow" id="headerEyebrow">🧪 Complete Chemistry Batch</span>
            <h1 class="shimmer-title" id="headerTitle">Chemistry Master Playlist</h1>
            <p class="subtitle" id="headerSubtitle">Class 01 to Class 34 • HD 720p Streams with Built-in HLS Player</p>
        </div>

        <div class="progress-panel">
            <div class="progress-ring" id="progressRing" style="background: conic-gradient(var(--cyan) 0deg, var(--violet) 0deg, var(--pink) 0deg, rgba(255,255,255,0.08) 0deg 360deg);">
                <span id="progressPercent">0%</span>
            </div>
            <div class="progress-meta">
                <div class="progress-count" id="progressCount">0 / 34 Watched</div>
                <div class="progress-sub" id="overallProgressSub">Total Science: 0 / 146</div>
                <button class="reset-btn" onclick="resetProgress()" title="Clear current subject watched history">
                    🔄 Reset Subject
                </button>
            </div>
        </div>
    </header>

    <div class="toolbar">
        <div class="search-wrap">
