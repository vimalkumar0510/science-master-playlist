    };

    let currentSubject = localStorage.getItem("science_active_tab") || "chem";
    if (!SUBJECTS[currentSubject]) currentSubject = "chem";

    let watchedState = {
        chem: JSON.parse(localStorage.getItem(SUBJECTS.chem.storageKey) || "{}"),
        bio:  JSON.parse(localStorage.getItem(SUBJECTS.bio.storageKey)  || "{}"),
        phy:  JSON.parse(localStorage.getItem(SUBJECTS.phy.storageKey)  || "{}")
    };

    let currentFilter = "all";
    let activeClassNum = null;
    let hlsInstance = null;

    const videoEl = document.getElementById("videoPlayer");
    const spinnerEl = document.getElementById("loadingSpinner");

    ["loadstart", "waiting", "seeking"].forEach(evt => {
        videoEl.addEventListener(evt, () => spinnerEl.classList.add("active"));
    });
    ["playing", "canplay", "seeked", "error"].forEach(evt => {
        videoEl.addEventListener(evt, () => spinnerEl.classList.remove("active"));
    });

    videoEl.addEventListener("ended", () => {
        if (activeClassNum && !watchedState[currentSubject][activeClassNum]) {
            watchedState[currentSubject][activeClassNum] = true;
            saveWatched();
        }
    });

    function switchSubject(subj) {
        if (!SUBJECTS[subj]) return;
        currentSubject = subj;
        localStorage.setItem("science_active_tab", subj);

        document.getElementById("tab-chem").classList.toggle("active", subj === "chem");
        document.getElementById("tab-bio").classList.toggle("active", subj === "bio");
        document.getElementById("tab-phy").classList.toggle("active", subj === "phy");

        const s = SUBJECTS[subj];
        document.getElementById("headerEyebrow").textContent = s.eyebrow;
        document.getElementById("headerTitle").textContent = s.title;
        document.getElementById("headerSubtitle").textContent = s.subtitle;
        document.getElementById("filter-all").textContent = `All (${s.classes.length})`;

        updateProgressUI();
        renderCards(true);
    }

    function saveWatched() {
        const s = SUBJECTS[currentSubject];
        localStorage.setItem(s.storageKey, JSON.stringify(watchedState[currentSubject]));
        updateProgressUI();
        renderCards(false);
        updateModalWatchedBtn();
    }

    function toggleWatched(n) {
        const map = watchedState[currentSubject];
        map[n] = !map[n];
        if (!map[n]) delete map[n];
        saveWatched();
    }

    function toggleCurrentWatched() {
        if (activeClassNum) toggleWatched(activeClassNum);
    }

    function resetProgress() {
        const s = SUBJECTS[currentSubject];
        const map = watchedState[currentSubject];
        const count = Object.keys(map).filter(k => map[k]).length;
        if (count === 0) {
            alert(`${s.name} progress is already at 0%!`);
            return;
        }
        if (confirm(`Kya aap ${s.name} ki saari watched classes (${count}/${s.classes.length}) ka progress reset karna chahte hain?`)) {
            watchedState[currentSubject] = {};
            saveWatched();
        }
    }

    function updateProgressUI() {
        const chemDone = SUBJECTS.chem.classes.filter(c => watchedState.chem[c.n]).length;
        const bioDone  = SUBJECTS.bio.classes.filter(c => watchedState.bio[c.n]).length;
        const phyDone  = SUBJECTS.phy.classes.filter(c => watchedState.phy[c.n]).length;

        document.getElementById("tabBadgeChem").textContent = `${chemDone} / ${SUBJECTS.chem.classes.length}`;
        document.getElementById("tabBadgeBio").textContent  = `${bioDone} / ${SUBJECTS.bio.classes.length}`;
        document.getElementById("tabBadgePhy").textContent  = `${phyDone} / ${SUBJECTS.phy.classes.length}`;

        const s = SUBJECTS[currentSubject];
        const total = s.classes.length;
        const done = currentSubject === "chem" ? chemDone : (currentSubject === "bio" ? bioDone : phyDone);
        const pct = Math.round((done / total) * 100);
        const deg = Math.round((done / total) * 360);

        document.getElementById("progressPercent").textContent = `${pct}%`;
        document.getElementById("progressCount").textContent = `${done} / ${total} Watched`;
        document.getElementById("overallProgressSub").textContent = `Total Science: ${chemDone + bioDone + phyDone} / 146`;
        document.getElementById("progressRing").style.background =
            `conic-gradient(var(--cyan) 0deg, var(--violet) ${deg * 0.65}deg, var(--pink) ${deg}deg, rgba(255,255,255,0.08) ${deg}deg 360deg)`;
    }

    function setFilter(filter) {
        currentFilter = filter;
        ["all", "watched", "unwatched"].forEach(f => {
            document.getElementById(`filter-${f}`).classList.toggle("active", f === filter);
        });
        renderCards(true);
    }

    function openModal(classNum) {
        const classes = SUBJECTS[currentSubject].classes;
        const item = classes.find(c => c.n === classNum);
        if (!item) return;

        activeClassNum = classNum;
        document.getElementById("modalTitle").textContent = item.t;
        document.getElementById("videoModal").classList.add("open");
        document.body.style.overflow = "hidden";
        updateModalWatchedBtn();

        spinnerEl.classList.add("active");
        const rate = parseFloat(document.getElementById("speedSelect").value);

        if (hlsInstance) {
            hlsInstance.destroy();
            hlsInstance = null;
        }

        if (Hls.isSupported()) {
            hlsInstance = new Hls();
            hlsInstance.loadSource(item.u);
            hlsInstance.attachMedia(videoEl);
            hlsInstance.on(Hls.Events.MANIFEST_PARSED, () => {
                videoEl.playbackRate = rate;
                videoEl.play().catch(() => spinnerEl.classList.remove("active"));
            });
            hlsInstance.on(Hls.Events.ERROR, (_, data) => {
                if (data.fatal) spinnerEl.classList.remove("active");
            });
        } else if (videoEl.canPlayType("application/vnd.apple.mpegurl")) {
            videoEl.src = item.u;
            videoEl.addEventListener("loadedmetadata", () => {
                videoEl.playbackRate = rate;
                videoEl.play().catch(() => spinnerEl.classList.remove("active"));
            }, { once: true });
        }
    }

    function updateModalWatchedBtn() {
        const btn = document.getElementById("modalWatchedBtn");
        if (!btn || !activeClassNum) return;
        const isDone = !!watchedState[currentSubject][activeClassNum];
        btn.textContent = isDone ? "✓ Watched (Click to Unmark)" : "✓ Mark as Watched";
        btn.style.borderColor = isDone ? "rgba(16, 185, 129, 0.6)" : "var(--glass-border)";
        btn.style.color = isDone ? "#34d399" : "var(--text-main)";
    }

    function playAdjacent(step) {
        if (!activeClassNum) return;
        const classes = SUBJECTS[currentSubject].classes;
        const nextNum = activeClassNum + step;
        if (nextNum >= 1 && nextNum <= classes.length) {
            openModal(nextNum);
        }
    }

    function closeModal() {
        videoEl.pause();
        videoEl.removeAttribute("src");
        if (hlsInstance) {
            hlsInstance.destroy();
            hlsInstance = null;
        }
        spinnerEl.classList.remove("active");
        document.getElementById("videoModal").classList.remove("open");
        document.body.style.overflow = "";
        activeClassNum = null;
    }

    function handleBackdropClick(e) {
        if (e.target.id === "videoModal") {
            closeModal();
        }
    }
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && document.getElementById("videoModal").classList.contains("open")) {
            closeModal();
        }
    });

    function changeSpeed(val) {
        videoEl.playbackRate = parseFloat(val);
    }

    function copyText(text, btnEl) {
        navigator.clipboard.writeText(text).then(() => {
            const orig = btnEl.innerHTML;
            btnEl.innerHTML = "✔ Copied";
            setTimeout(() => btnEl.innerHTML = orig, 1300);
        });
    }

    function copyAllLinks() {
        const s = SUBJECTS[currentSubject];
        const text = s.classes.map(c => `${c.t}\n${c.u}`).join("\n\n");
        navigator.clipboard.writeText(text).then(() => {
            alert(`${s.name} ke saare ${s.classes.length} classes ke titles aur links clipboard mein copy ho gaye hain!`);
        });
    }

    
    function downloadCurrentVideo() {
        const classes = SUBJECTS[currentSubject].classes;
        const item = classes.find(c => c.n === activeClassNum);
        if (!item) return;
        
        // Create a temporary anchor to download the .m3u8 link or open instructions
        const a = document.createElement('a');
        a.href = item.u;
        a.target = '_blank';
        a.download = item.t.replace(/[^a-zA-Z0-9]/g, '_') + '.m3u8';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
    }

    
    function downloadMasterPlaylist() {
        const htmlContent = "<!DOCTYPE html>\n" + document.documentElement.outerHTML;
        const blob = new Blob([htmlContent], { type: "text/html;charset=utf-8" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = "science_master_playlist.html";
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
    }

    function renderCards(animate = true) {
        const query = document.getElementById("searchInput").value.toLowerCase().trim();
        const grid = document.getElementById("classGrid");
        grid.innerHTML = "";

        const classes = SUBJECTS[currentSubject].classes;
        const watchedMap = watchedState[currentSubject];
        const isBio = currentSubject === "bio";
        const isPhy = currentSubject === "phy";

        const filtered = classes.filter(c => {
            const matchesSearch = c.t.toLowerCase().includes(query) || String(c.n).includes(query);
            const isDone = !!watchedMap[c.n];
            if (currentFilter === "watched") return matchesSearch && isDone;
            if (currentFilter === "unwatched") return matchesSearch && !isDone;
            return matchesSearch;
        });

        if (filtered.length === 0) {
            grid.innerHTML = `<div class="empty-state">No classes match your current search or filter.</div>`;
            return;
        }

        filtered.forEach((c, idx) => {
            const isDone = !!watchedMap[c.n];
            const card = document.createElement("div");
            card.className = "class-card" + (isDone ? " watched" : "");

            if (animate) {
                card.style.animationDelay = `${Math.min(idx * 0.03, 0.8)}s`;
            } else {
                card.style.animation = "none";
                card.style.opacity = "1";
            }

            let badgeClass = "";
            let badgeText = "";
            let btnClass = "";

            if (isBio) {
                badgeClass = "bio-badge";
                badgeText = `BIO #${String(c.n).padStart(2, '0')}`;
                btnClass = "bio-play";
            } else if (isPhy) {
                badgeClass = "phy-badge";
                badgeText = `PHY #${String(c.n).padStart(2, '0')}`;
                btnClass = "phy-play";
            } else {
                badgeClass = "";
                badgeText = `CHEM #${String(c.n).padStart(2, '0')}`;
                btnClass = "";
            }

            card.innerHTML = `
                <div>
                    <div class="card-top">
                        <span class="badge ${badgeClass}">${badgeText}</span>
                        <span class="watched-pill ${isDone ? 'is-watched' : ''}" onclick="toggleWatched(${c.n})" title="Toggle Watched Status">
                            ${isDone ? '✓ Watched' : '○ Mark Watched'}
                        </span>
                    </div>
                    <div class="card-title" style="margin-top:12px;" onclick="openModal(${c.n})">
                        ${c.t}
                    </div>
                    <div class="topic-tag">${c.u}</div>
                </div>
                <div class="card-actions">
                    <button class="btn btn-play ${btnClass}" onclick="openModal(${c.n})">▶ Play Video</button>
                    <button class="btn" onclick='copyText(${JSON.stringify(c.u)}, this)' title="Copy Stream Link">📋 Copy</button>
                    <a class="btn" href="${c.u}" target="_blank" rel="noopener noreferrer" title="Open Direct Link">🔗</a>
                </div>
            `;
            grid.appendChild(card);
        });
    }

    switchSubject(currentSubject);
</script>



